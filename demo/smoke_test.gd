extends SceneTree
const Rules = preload("res://demo_rules.gd")

func _initialize() -> void:
    var life: Dictionary = Rules.create_life("Woman", 2, 42, 1)
    assert(int(life["age"]) == 0)
    assert(str(life["gender"]) == "Woman")
    assert(Rules.ELEMENTS.has(life["element"]))
    assert(Rules.TALENTS.has(life["talent"]))
    assert(Rules.CAREERS.size() == 4)
    for age in [0, 6, 7, 12, 16, 30, 60, 84]:
        var event: Dictionary = Rules.event_for_age(age, 11, life)
        assert(event.has("story"))
        assert(event["choices"].size() >= 2)
    var childhood: Dictionary = Rules.event_for_age(0, 1, life)
    var chosen: Dictionary = Rules.apply_choice(life, childhood["choices"][0])
    assert(bool(chosen["acted"]))
    assert(chosen["history"].size() == 1)
    var duplicate: Dictionary = Rules.apply_choice(chosen, childhood["choices"][0])
    assert(int(duplicate["bond"]) == int(chosen["bond"]))
    var year: Dictionary = Rules.advance_year(chosen)
    assert(int(year["age"]) == 1)
    assert(not bool(year["acted"]))
    assert(int(Rules.advance_year(year)["age"]) == 1)
    var first_activity: Dictionary = Rules.activity(year, "Study")
    assert(int(first_activity["knowledge"]) == int(year["knowledge"]) + 2)
    assert(int(Rules.activity(first_activity, "Study")["knowledge"]) == int(first_activity["knowledge"]))
    var social: Dictionary = Rules.spend_time(year)
    assert(int(Rules.spend_time(social)["friendship"]) == int(social["friendship"]))
    assert(str(Rules.choose_career(year, "Artisan")["career"]) == "Undecided")
    var adult: Dictionary = Rules.skip_to_adult(year)
    assert(int(adult["age"]) == 16)
    var career: Dictionary = Rules.choose_career(adult, "Artisan")
    assert(str(career["career"]) == "Artisan")
    assert(str(Rules.choose_career(career, "Trader")["career"]) == "Artisan")
    var purchase: Dictionary = Rules.buy_item(career, "Travel Pack")
    assert(purchase["bag"].has("Travel Pack"))
    assert(int(purchase["coins"]) == int(career["coins"]) - 12)
    assert(int(Rules.buy_item(purchase, "Travel Pack")["coins"]) == int(purchase["coins"]))
    var old_save: Dictionary = {"name":"Old","age":20,"gender":"Man","health":90,"coins":5,
        "renown":0,"bond":0,"year":21,"acted":false,"ended":false}
    var migrated: Dictionary = Rules.normalize(old_save)
    assert(migrated.has("friendship") and migrated.has("bag"))
    var old_life: Dictionary = Rules.skip_to_adult(life)
    assert(Rules.stage_for_age(16) == "Adulthood")
    assert(Rules.stage_for_age(66) == "Later Life")
    print("VEYRA_PORTFOLIO_SMOKE_PASS_V02")
    print("VEYRA_PORTFOLIO_SMOKE_PASS")
    quit(0)
